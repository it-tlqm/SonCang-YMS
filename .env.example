# Supabase URL & Public Key (hỗ trợ cả Publishable Key dạng mới và Anon Key JWT)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key

# Cấu hình môi trường chạy (development | staging | production)
NODE_ENV=development

# Feature Flags kiểm soát an toàn PWA
NEXT_PUBLIC_ENABLE_REAL_WRITE=false
NEXT_PUBLIC_ALLOW_DEMO_MODE=true
